<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.openoa.engine.bpmnconf.mapper.DemoDataBusinessDataMapper">

    <!--
        查询低代码字段值竖表。
        注意: 参数名必须为 formCode, LFConsistentHashingRoutingSqlInterceptor 依赖该参数名
        做一致性哈希分表路由; 若配置了 lf.main.table.count/field.table.count >= 2,
        该 SQL 会被改写路由到对应的物理分表。
    -->
    <select id="selectLfMainFieldsByMainIds" resultType="org.openoa.engine.lowflow.entity.LFMainField">
        select
            id,
            main_id,
            form_code,
            field_id,
            field_name,
            parent_field_id,
            parent_field_name,
            field_value,
            field_value_number,
            field_value_dt,
            field_value_text,
            sort
        from t_lf_main_field
        where form_code = #{formCode}
          and is_del = 0
          and main_id in
        <foreach collection="mainIds" item="mainId" open="(" separator="," close=")">
            #{mainId}
        </foreach>
        order by main_id, sort
    </select>
</mapper>
